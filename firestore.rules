rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Media collection - portfolio photos and videos
    match /media/{mediaId} {
      // Anyone can read media (for public portfolio)
      allow read: if true;
      
      // Only authenticated admins can create, update, delete
      allow create, update, delete: if isAuthenticated();
    }
    
    // Contact requests - allow anyone to create, only admins to read/update
    match /contactRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }
    
    // Quote requests - allow anyone to create, only admins to read/update
    match /quoteRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }
    
    // Admin users - only authenticated admins can read
    match /adminUsers/{userId} {
      allow read: if isAuthenticated();
      allow write: if false; // Prevent modification through client
    }
  }
}